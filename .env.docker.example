# Copy to .env before running: cp .env.docker.example .env
# Full stack: docker compose --profile app up --build

CODETHERA_APP_NAME=CodeThera
CODETHERA_ENVIRONMENT=production
CODETHERA_API_PREFIX=/api/v1
CODETHERA_HOST=0.0.0.0
CODETHERA_PORT=8000
CODETHERA_CORS_ORIGINS=http://localhost:5173,http://localhost
CODETHERA_WORKSPACE_ROOT=/workspace
CODETHERA_LOG_LEVEL=INFO
CODETHERA_LOG_FORMAT=json
CODETHERA_MONGODB_URI=mongodb://mongodb:27017
CODETHERA_MONGODB_DATABASE_NAME=codethera
CODETHERA_MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
CODETHERA_MONGODB_CONNECT_TIMEOUT_MS=5000
CODETHERA_JWT_SECRET_KEY=change-me-in-production
CODETHERA_JWT_ALGORITHM=HS256
CODETHERA_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CODETHERA_CREDENTIALS_ENCRYPTION_KEY=change-me-32-characters-minimum
CODETHERA_GITHUB_API_BASE_URL=https://api.github.com
CODETHERA_GITLAB_API_BASE_URL=https://gitlab.com/api/v4

# Frontend build arg (used by docker compose build)
VITE_API_BASE_URL=/api/v1
