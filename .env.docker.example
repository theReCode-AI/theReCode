# Copy to .env before running: cp .env.docker.example .env
# Full stack: docker compose --profile app up --build

THERECODE_APP_NAME=theReCode
THERECODE_ENVIRONMENT=production
THERECODE_API_PREFIX=/api/v1
THERECODE_HOST=0.0.0.0
THERECODE_PORT=8000
THERECODE_CORS_ORIGINS=http://localhost:5173,http://localhost
THERECODE_WORKSPACE_ROOT=/workspace
THERECODE_LOG_LEVEL=INFO
THERECODE_LOG_FORMAT=json
THERECODE_MONGODB_URI=mongodb://mongodb:27017
THERECODE_MONGODB_DATABASE_NAME=therecode
THERECODE_MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
THERECODE_MONGODB_CONNECT_TIMEOUT_MS=5000
THERECODE_JWT_SECRET_KEY=change-me-in-production
THERECODE_JWT_ALGORITHM=HS256
THERECODE_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
THERECODE_CREDENTIALS_ENCRYPTION_KEY=change-me-32-characters-minimum
THERECODE_GITHUB_API_BASE_URL=https://api.github.com
THERECODE_GITLAB_API_BASE_URL=https://gitlab.com/api/v4

# Frontend build arg (used by docker compose build)
VITE_API_BASE_URL=/api/v1
