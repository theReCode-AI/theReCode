# theReCode Backend Configuration
THERECODE_APP_NAME=theReCode
THERECODE_ENVIRONMENT=development
THERECODE_API_PREFIX=/api/v1
THERECODE_HOST=0.0.0.0
THERECODE_PORT=8000
THERECODE_CORS_ORIGINS=http://localhost:5173
THERECODE_WORKSPACE_ROOT=../workspace
THERECODE_LOG_LEVEL=INFO
THERECODE_LOG_FORMAT=text
THERECODE_MONGODB_URI=mongodb://localhost:27017
# If your MongoDB container uses auth (e.g. MONGO_INITDB_ROOT_USERNAME/PASSWORD):
# THERECODE_MONGODB_URI=mongodb://admin:yourpassword@localhost:27017/therecode?authSource=admin
THERECODE_MONGODB_DATABASE_NAME=therecode
THERECODE_MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
THERECODE_MONGODB_CONNECT_TIMEOUT_MS=5000
THERECODE_JWT_SECRET_KEY=dev-secret-change-in-production
THERECODE_JWT_ALGORITHM=HS256
THERECODE_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
THERECODE_CREDENTIALS_ENCRYPTION_KEY=dev-encryption-key-change-in-production-32b
THERECODE_GITHUB_API_BASE_URL=https://api.github.com
THERECODE_GITLAB_API_BASE_URL=https://gitlab.com/api/v4

# Google ADK 2.x — Gemini API (not Vertex AI)
# Get a key from https://aistudio.google.com/apikey
THERECODE_GOOGLE_API_KEY=
THERECODE_GOOGLE_GENAI_USE_VERTEXAI=false
THERECODE_GEMINI_MODEL=gemini-2.5-flash
THERECODE_GOOGLE_ADK_APP_NAME=therecode

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
