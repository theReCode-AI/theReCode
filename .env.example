# CodeThera Backend Configuration
CODETHERA_APP_NAME=CodeThera
CODETHERA_ENVIRONMENT=development
CODETHERA_API_PREFIX=/api/v1
CODETHERA_HOST=0.0.0.0
CODETHERA_PORT=8000
CODETHERA_CORS_ORIGINS=http://localhost:5173
CODETHERA_WORKSPACE_ROOT=../workspace
CODETHERA_LOG_LEVEL=INFO
CODETHERA_LOG_FORMAT=text
CODETHERA_MONGODB_URI=mongodb://localhost:27017
# If your MongoDB container uses auth (e.g. MONGO_INITDB_ROOT_USERNAME/PASSWORD):
# CODETHERA_MONGODB_URI=mongodb://admin:yourpassword@localhost:27017/codethera?authSource=admin
CODETHERA_MONGODB_DATABASE_NAME=codethera
CODETHERA_MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
CODETHERA_MONGODB_CONNECT_TIMEOUT_MS=5000
CODETHERA_JWT_SECRET_KEY=dev-secret-change-in-production
CODETHERA_JWT_ALGORITHM=HS256
CODETHERA_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CODETHERA_CREDENTIALS_ENCRYPTION_KEY=dev-encryption-key-change-in-production-32b
CODETHERA_GITHUB_API_BASE_URL=https://api.github.com
CODETHERA_GITLAB_API_BASE_URL=https://gitlab.com/api/v4

# Google ADK 2.x — Gemini API (not Vertex AI)
# Get a key from https://aistudio.google.com/apikey
CODETHERA_GOOGLE_API_KEY=
CODETHERA_GOOGLE_GENAI_USE_VERTEXAI=false
CODETHERA_GEMINI_MODEL=gemini-2.5-flash
CODETHERA_GOOGLE_ADK_APP_NAME=codethera

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
